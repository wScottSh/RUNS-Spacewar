# spacewar:match_result — Match State and Scores
#
# Dual-use Record: internal persistent state AND outbound boundary.
# Appears in both state: and produces: in game_tick.runs.
# Game logic Processors read/write it; the runtime also reads it
# after each tick for scoring and lifecycle display.
#
# Source: 02_record_definitions.md § spacewar:match_result

record spacewar:match_result
  scope:     state + outbound boundary
  instances: 1

  fields:

    state:                        spacewar:match_lifecycle
      # Current lifecycle state.
      # Source: derived from L717-791 state machine.
      default: playing

    score_1:                      int
      # Player 1 score.
      # Source: \1sc (L746, L768, L777, L784).
      # Incremented when ship 1 survives a round.
      default: 0

    score_2:                      int
      # Player 2 score.
      # Source: \2sc (L752, L769, L778, L785).
      default: 0

    rounds_remaining:             int
      # Games left in match.
      # Source: \gct (L764, L767, L772, L791).
      # Initialized from game_config.game_count.
      # 0 = infinite play.
      default: 0

    restart_timer:                int
      # Frames until next round begins. 0 if not in countdown.
      # Source: \ntd (L735, L738).
      # Set to 2 × torpedo_lifetime on round end.
      default: 0

    trigger_reinit:               bool
      # If true, the runtime must call match_initialize before
      # the next game_tick. Set by update_scores when the restart
      # timer crosses from negative to positive.
      # Source: L754 (jmp a — jump to restart logic).
      default: false
