# The outline compiler's Processors. oc's entry word, outline_call.code, is
# where the next word of code goes.

processor start_reading                                     # dap ocg
  reads: outline_call
  writes: outline_compiler
  set outline_compiler.table = outline_call.table

# One word of code (plinst).
processor lay_out(instruction)
  writes: outline_code, outline_call
  set outline_code.insn[outline_call.code] = instruction
  set outline_call.code = outline_call.code + 1

processor mark_start                                        # dap ocm
  reads: outline_call
  writes: outline_compiler
  set outline_compiler.start_over = jmp(outline_code.insn[outline_call.code])

processor store_first                                       # clf 6
  writes: outline_compiler
  set outline_compiler.six = store

processor take_word                                         # setup \occ, 6; ocg, lio .
  reads: outlines
  writes: outline_compiler, handoff
  set outline_compiler.codes_left = -6
  set handoff.codes = outlines.codes[outline_compiler.table]

processor take_code                                         # och
  writes: handoff, outline_compiler
  set handoff.direction = 0                                 # cla
  set (handoff.direction, handoff.codes) = rcl(handoff.direction, handoff.codes, 3)
  set outline_compiler.codes_rest = handoff.codes           # dio \oci
  set handoff.swap = rcl(9)                                 # lio (rcl 9s

# Half a swap, twice: AC and IO change places in the code (ocs).
processor compile_swap
  reads: handoff
  writes: outline_code, outline_call
  set outline_code.insn[outline_call.code] = handoff.swap
  set outline_call.code = outline_call.code + 1
  set outline_code.insn[outline_call.code] = handoff.swap
  set outline_call.code = outline_call.code + 1

# The word the next lay_out_pending lays out (lac).
processor pend(instruction)
  writes: handoff
  set handoff.pending = instruction

processor lay_out_pending                                   # dac i oc; idx oc
  reads: handoff
  writes: outline_code, outline_call
  set outline_code.insn[outline_call.code] = handoff.pending
  set outline_call.code = outline_call.code + 1

processor take_rest                                         # lio \oci
  reads: outline_compiler
  writes: handoff
  set handoff.codes = outline_compiler.codes_rest

processor count_code
  writes: outline_compiler
  set outline_compiler.codes_left = outline_compiler.codes_left + 1

processor next_word                                         # idx ocg
  writes: outline_compiler
  set outline_compiler.table = outline_compiler.table + 1

processor six_stored                                        # stf 6
  writes: outline_compiler
  set outline_compiler.six = restore

processor six_restored                                      # clf 6
  writes: outline_compiler
  set outline_compiler.six = store

# The first side's jump past the return, four words on (add (4; dap ocn).
processor jump_to_other_side
  writes: outline_compiler, outline_code, outline_call
  set outline_compiler.to_other_side = jmp(outline_code.insn[outline_call.code + 4])
  set outline_code.insn[outline_call.code] = outline_compiler.to_other_side
  set outline_call.code = outline_call.code + 1

# Back to the second side's start (plinst ocm).
processor jump_to_start
  reads: outline_compiler
  writes: outline_code, outline_call
  set outline_code.insn[outline_call.code] = outline_compiler.start_over
  set outline_call.code = outline_call.code + 1
