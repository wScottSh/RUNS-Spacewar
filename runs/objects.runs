# Calc routines for objects that are not flying spaceships: the explosion,
# the torpedo, and a ship in hyperspace and at breakout. The main loop runs
# the one the object's routine word names, once a frame. Each fires the
# Processors of objects.runs-prim, the macros and the tunables in the
# original's order; the guards test what the original's skips test.

# An exploding object keeps drifting and is drawn as a cloud of dots, one
# per 8 instructions of its size, for as many frames as its counter has
# left; then its slot is freed.
network explosion(slot)                                     # mex
  run coast                                                 # cla
  run inertia_x(slot)
  run inertia_y(slot)
  run size_explosion(slot)
  loop at most 0400001:                                     # mz1
    run next_random
    run scatter_particle                                    # dac mi1
    run next_random
    run plot_particle(slot)
    if explosion_cloud.particles >= 0:                      # count \mxc, mz1
      break
  run count_down(slot)                                      # count i ma1, mxr
  if objects.counter[slot] >= 0:
    run free_slot(slot)

# A torpedo flies straight, bent only by the torpedo space warpage, until
# its life runs out and it explodes.
network torpedo(slot)                                       # tcr
  run count_down(slot)                                      # count i ma1, tc1
  if objects.counter[slot] >= 0:
    run explode_torpedo(slot)
  else:
    run warp_from_x(slot)                                   # tc1
    run torpedo_space_warpage
    run inertia_y(slot)
    run warp_from_y(slot)
    run torpedo_space_warpage
    run inertia_x(slot)
    run plot_torpedo(slot)

# A ship in hyperspace is not drawn and does not collide. When its time is
# up it jumps by a random displacement, takes a random velocity and
# heading, and breakout begins.
network in_hyperspace(slot)                                 # hp1
  requires: slot < 2
  run count_down(slot)                                      # count i ma1, hp2
  if objects.counter[slot] >= 0:
    run begin_breakout(slot)
    run next_random
    run draw_jump
    run hyperspatial_displacement
    run jump(slot)
    run next_random
    run draw_jump
    run hyperspatial_velocity
    run head_out(slot)
    run breakout_time
    run time_breakout(slot)

# Breakout: the ship shows as a dot and can collide again. When its time is
# up it gets its own calc routine back, uses up a jump, starts the
# hyperfield generators' recharge and takes on more uncertainty; then it
# survives only if a random number outweighs the uncertainty.
network breakout(slot)                                      # hp3
  requires: slot < 2
  run count_down(slot)                                      # count i ma1, hp6
  if objects.counter[slot] < 0:
    run show_breakout(slot)                                 # hp6
  else:
    run end_breakout(slot)
    run hyperfield_recharge_time                            # hp7
    run recharge_hyperfield(slot)
    run next_random
    if (random.number | 0400000) + ships.uncertainty[slot] >= 0:   # spa; jmp hp5
      run lost_in_hyperspace(slot)
      run show_breakout(slot)
