# The arithmetic subroutines and the random number generator. Functions:
# words in, words out, no Records.

# BBN integer square root (sqt). Binary point right of bit 17 on the way in,
# between bits 8 and 9 on the way out. Two bits of input per pass, 18 passes.
function square_root(input: word) -> word
  let passes_left = -023
  let root = 0
  let input_bits = input
  let remainder = 0
  loop at most 023:
    set passes_left = passes_left + 1
    if passes_left >= 0:
      return root
    set root = root << 1
    let next = remainder
    set (next, input_bits) = rcl(next, input_bits, 2)
    if next == 0:
      continue
    set remainder = next
    set next = (root << 1) + 1 - remainder
    if next > 0:
      continue
    if next < 0:
      set next = -next
    set remainder = next
    set root = root + 1

# The `random` macro: the next value of the generator.
function next_random(number: word) -> word
  return (rar(number, 1) ^ 0355670) + 0355670

# The `diff` macro, inertia: the acceleration joins the velocity, and an
# eighth of the velocity the position.
function inertia(acceleration: word, velocity: word, position: word) -> (word, word)
  let v = acceleration + velocity
  return (v, (v >> 3) + position)
