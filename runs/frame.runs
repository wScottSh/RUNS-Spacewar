# The main loop and the game control around it. One pass of the main loop
# is one frame (ml0 .. ml0). The Networks only decide what fires: their
# guards read Records, and every value they move between Processors goes
# through a Record.
#
# The game has three top Networks, which nothing fires. The operator starts
# the machine at 4 or at 5, and the host fires the matching start Network
# once; then it fires the frame, once each frame, for as long as the game
# runs. Each top Network's contract is the game's boundary with
# presentation: the points and the scores leave, the console and the
# words core held at power-on come in.

network start_with_test_word                                # a1: started at 5
  reads: console, score, outline_space
  writes: scoreboard
  run use_test_word
  run between_games

network start_with_control_boxes                            # a40: started at 4
  reads: console, outline_space
  run use_control_boxes
  run new_match

# The ships' outlines are presentation: each spaceship hands its compiled
# outline the pen, and the outline hands back the pen at the ship's tail.
# Which device the control word comes from is the operator's choice of
# start address, made before the first frame.
network frame                                               # ml0
  reads: console, score, outline_space, controls, pen
  writes: display, scoreboard, lights, pen
  run begin_frame
  # The restart checks: while both ships fly on their own calc routines and
  # one still has torpedoes, the restart delay is held; otherwise it counts
  # down, and then the survivors score.
  if objects.routine[0] == first_spaceship and objects.routine[1] == second_spaceship and (1 + ships.torpedoes[0] < 0 or 1 + ships.torpedoes[1] < 0):
    run torpedo_life                                        # md1: xct tlf
    run hold_restart
    run object_loop
  else:
    run count_down_restart                                  # mdn: count \ntd, ml1
    if frame.restart_delay < 0:
      run object_loop
    else:
      run score_survivors
      run between_games

# The object loop (ml1): each active object that can collide is tested
# against every later one that can, then its calc routine runs and its time
# is charged to the frame. The last object has no later one to test, and is
# not counted. An explosion and a ship in hyperspace cannot collide; core
# keeps that in the routine word's sign bit.
network object_loop                                         # ml1
  for slot in 0 .. 026:
    if objects.routine[slot] != none:
      run count_object
      if objects.routine[slot] != explosion and objects.routine[slot] != in_hyperspace:
        for other in slot + 1 .. 027:
          if objects.routine[other] != none and objects.routine[other] != explosion and objects.routine[other] != in_hyperspace:
            run collision(slot, other)
      run calc(slot)                                        # mq4
      run charge_time(slot)
  if objects.routine[027] != none:
    run calc(027)
    run charge_time(027)
  run expensive_planetarium                                 # mq3
  run central_star
  run spare_time

# The calc routine the object's routine word names.
network calc(slot)
  match objects.routine[slot]:
    none: unreachable
    first_spaceship: run first_spaceship(slot)
    second_spaceship: run second_spaceship(slot)
    torpedo: run torpedo(slot)
    explosion: run explosion(slot)
    in_hyperspace: run in_hyperspace(slot)
    breakout: run breakout(slot)

# After a game (a). In a match the game count steps on, and a tie at the end
# adds a game. The machine halts to show the scores after every game with
# test word switch 040 on, and at the end of a match.
network between_games                                       # a
  if score.games_left >= 0:
    run ask
  else:
    run count_game                                          # count \gct, a5
    if score.games_left < 0:
      run ask
    else:
      if score.first != score.second:
        run show_scores
      else:
        run play_off
        run ask

network ask                                                 # a5
  if console.test_word & 040 == 0:
    run new_game
  else:
    run show_scores

# The scores show on the console lights, ship 1's in AC and ship 2's in IO,
# while the machine waits. Continuing with switch 040 off clears them and
# starts a new match.
network show_scores                                         # a4
  run post_scores
  wait                                                      # hlt
  if console.test_word & 040 != 0:
    run new_game
  else:
    run clear_scores
    run new_match

network new_match                                           # a6
  run count_games
  run new_game

# A new game (a2): clear the whole object table, put the ships in opposite
# corners with the needle turned around, compile their outlines into the
# free core after the table, and arm them.
network new_game                                            # a2
  run clear_tables
  run place_ships
  run outlines_from_free_core
  # When separate_outlines is +0 both ships share one outline, the wedge,
  # which leaves room for ddt (a3).
  if tunables.separate_outlines < 0:                        # lio ddd; spi i
    run choose_needle
    run compile_outline                                     # jda oc / ot1
  run second_outline                                        # a3
  run compile_outline                                       # jda oc / ot2
  run torpedo_supply                                        # xct tno
  run arm_ships
  run hyperspace_shots                                      # xct mhs
  run give_jumps

# The control word, from the device the start picked (jsp i \cwg). Each
# spaceship reads it, once a frame.
network control_word
  reads: controls, console
  writes: handoff
  match controls.source:
    test_word: run read_test_word
    control_boxes: run read_control_boxes
