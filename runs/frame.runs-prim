# The main loop's own Processors.

processor begin_frame                                       # ml0: load \mtc, -4000
  writes: frame
  let budget = -04000
  set frame.spare_time = budget

processor hold_restart                                      # md1: twice a torpedo's life
  reads: handoff
  writes: frame
  set frame.restart_delay = handoff.torpedo_life << 1

processor count_down_restart
  writes: frame
  set frame.restart_delay = frame.restart_delay + 1

processor count_object
  writes: frame
  set frame.objects_seen = frame.objects_seen + 1

# Both objects explode when they come within an octagon around each other:
# |dx| and |dy| below the collision radius, and |dx| + |dy| below one and a
# half of it. The explosion lasts longer the more time the two calc
# routines take.
processor collision(slot, other)
  reads: tunables
  writes: objects
  let dx = objects.x[slot] - objects.x[other]
  if dx < 0:
    set dx = -dx
  if dx - tunables.collision_radius >= 0:
    return
  let dy = objects.y[slot] - objects.y[other]
  if dy < 0:
    set dy = -dy
  set dy = dy - tunables.collision_radius
  if dy >= 0:
    return
  if dy + dx - tunables.collision_radius_half >= 0:
    return
  set objects.routine[slot] = explosion
  set objects.routine[other] = explosion
  let frames = objects.cycles[slot] + objects.cycles[other]
  set frames = (-frames >> 8) + 1
  set objects.counter[slot] = frames
  set objects.counter[other] = frames

processor charge_time(slot)                                 # mq4
  writes: frame
  reads: objects
  set frame.spare_time = objects.cycles[slot] + frame.spare_time

# The spare-time loop burns the rest of the frame's instruction budget. It
# is pacing: begin_frame, charge_time and spare_time alone use the budget,
# and nothing in the game reads it after, so its effects are presentation.
processor spare_time
  writes: frame
  loop at most 0400001:
    set frame.spare_time = frame.spare_time + 1
    if frame.spare_time >= 0:
      break

# The survivors score: a ship whose routine word is still its own calc
# routine survived. Program flags 1 and 2 light for the survivors, but flag
# 2 is cleared again at once.
processor score_survivors                                   # mdn, once the delay runs out
  reads: objects
  writes: score, lights
  set lights.first_survived = on                            # stf 1
  set lights.second_survived = on                           # stf 2
  if objects.routine[0] != first_spaceship:
    set lights.first_survived = off
  if objects.routine[0] == first_spaceship:
    set score.first = score.first + 1
  if objects.routine[1] != second_spaceship:
    set lights.second_survived = off
  if objects.routine[1] == second_spaceship:
    set score.second = score.second + 1
  set lights.second_survived = off

processor use_test_word                                     # a1
  writes: controls
  set controls.source = test_word

processor use_control_boxes                                 # a40
  writes: controls
  set controls.source = control_boxes

processor count_game
  writes: score
  set score.games_left = score.games_left + 1

# A tie at the end of a match: one more game.
processor play_off
  writes: score
  set score.games_left = -1

processor post_scores
  reads: score
  writes: scoreboard
  emit scoreboard, score.first, score.second

processor clear_scores
  writes: score
  set score.first = 0
  set score.second = 0

# The five test word switches above the scores switch give the number of
# games in the match.
processor count_games                                       # a6
  reads: console
  writes: score
  let games = rar(console.test_word, 6) & 037
  if games != 0:
    set games = -games
  set score.games_left = games

processor clear_tables                                      # clear mtb, nnn-1
  writes: objects, ships
  for slot in 0 .. 027:
    set objects.routine[slot] = none
    set objects.x[slot] = 0
    set objects.y[slot] = 0
    set objects.counter[slot] = 0
    set objects.cycles[slot] = 0
    set objects.dx[slot] = 0
    set objects.dy[slot] = 0
  for ship in 0 .. 1:
    set ships.angular_momentum[ship] = 0
    set ships.angle[ship] = 0
    set ships.fuel[ship] = 0
    set ships.torpedoes[ship] = 0
    set ships.outline[ship] = 0
    set ships.previous_control[ship] = 0
    set ships.saved_routine[ship] = none
    set ships.jumps_left[ship] = 0
    set ships.recharge[ship] = 0
    set ships.uncertainty[ship] = 0

processor place_ships
  writes: objects, ships
  set objects.routine[0] = first_spaceship
  set objects.routine[1] = second_spaceship
  let corner = 0200000
  set objects.x[0] = corner
  set objects.y[0] = corner
  set corner = -corner
  set objects.x[1] = corner
  set objects.y[1] = corner
  set ships.angle[0] = 0144420                              # pi

# The outlines go into the free core after the table, from its first word.
processor outlines_from_free_core                           # law nnn; dac not
  writes: outline_call, ships
  set outline_call.code = 0
  set ships.outline[0] = outline_call.code

processor choose_needle
  writes: outline_call
  set outline_call.table = 0                                # ot1

processor second_outline                                    # a3
  reads: outline_call
  writes: ships, outline_call
  set ships.outline[1] = outline_call.code
  set outline_call.table = 010                              # ot2

processor arm_ships
  reads: handoff, tunables
  writes: ships, objects
  let torpedoes = handoff.torpedo_supply
  set ships.torpedoes[0] = torpedoes
  set ships.torpedoes[1] = torpedoes
  let fuel = tunables.fuel_supply
  set ships.fuel[0] = fuel
  set ships.fuel[1] = fuel
  # The calc routine's time for the first frame, before it has run.
  let cycles = 02000
  set objects.cycles[0] = cycles
  set objects.cycles[1] = cycles

processor give_jumps
  reads: handoff
  writes: ships
  let jumps = handoff.hyperspace_shots
  set ships.jumps_left[0] = jumps
  set ships.jumps_left[1] = jumps

# The control word getters (mg1, mg2): each leaves the control word in IO.
processor read_control_boxes                                # mg1
  reads: console
  writes: handoff
  set handoff.control_word = console.control_boxes

processor read_test_word                                    # mg2
  reads: console
  writes: handoff
  set handoff.control_word = console.test_word
