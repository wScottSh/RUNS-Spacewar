# The main loop's own Processors.

function collides(routine: calc_routine) -> bool
  return routine != explosion and routine != in_hyperspace

processor begin_frame                                       # ml0
  writes: frame
  set frame.spare_time = -04000

processor hold_restart                                      # md1: twice a torpedo's life
  writes: frame
  set frame.restart_delay = torpedo_life() << 1

processor count_down_restart
  writes: frame
  set frame.restart_delay = frame.restart_delay + 1

processor count_object
  writes: frame
  set frame.objects_seen = frame.objects_seen + 1

# Both objects explode when they come within an octagon around each other:
# |dx| and |dy| below the collision radius, and |dx| + |dy| below one and a
# half of it. The explosion lasts longer the more time the two calc
# routines take.
processor collision(slot, other)
  reads: tunables
  writes: objects
  let dx = objects.x[slot] - objects.x[other]
  if dx < 0:
    set dx = -dx
  if dx - tunables.collision_radius >= 0:
    return
  let dy = objects.y[slot] - objects.y[other]
  if dy < 0:
    set dy = -dy
  set dy = dy - tunables.collision_radius
  if dy >= 0:
    return
  if dy + dx - tunables.collision_radius_half >= 0:
    return
  set objects.routine[slot] = explosion
  set objects.routine[other] = explosion
  let frames = objects.cycles[slot] + objects.cycles[other]
  set frames = (-frames >> 8) + 1
  set objects.counter[slot] = frames
  set objects.counter[other] = frames

processor charge_time(slot)                                 # mq4
  writes: frame
  reads: objects
  set frame.spare_time = objects.cycles[slot] + frame.spare_time

# The spare-time loop burns the rest of the frame's instruction budget.
processor spare_time
  writes: frame
  loop at most 0400001:
    set frame.spare_time = frame.spare_time + 1
    if frame.spare_time >= 0:
      break
