# Calc routines for objects that are not flying spaceships: the explosion,
# the torpedo, and a ship in hyperspace and at breakout. The main loop runs
# the one the object's routine word names, once a frame.

# An exploding object keeps drifting and is drawn as a cloud of dots, one
# per 8 instructions of its size, for as many frames as its counter has
# left; then its slot is freed.
processor explosion(slot)                                   # mex
  writes: objects, random, display
  set (objects.dx[slot], objects.x[slot]) = inertia(0, objects.dx[slot], objects.x[slot])
  set (objects.dy[slot], objects.y[slot]) = inertia(0, objects.dy[slot], objects.y[slot])
  let spread = 1                    # spread_scales: scr 1s, or scr 3s
  let particles = -objects.cycles[slot]
  let low = 0
  set particles = particles >> 3
  # Meant to give a big explosion the wider spread, but particles is
  # negative here for any real size, so the test never passes.
  if particles - 0140 >= 0:
    set spread = 3
  loop at most 0400001:
    set random.number = next_random(random.number)
    let shift = popcount(random.number & 0777)
    set random.number = next_random(random.number)
    let high = random.number
    set (high, low) = scr(high, low, 9)
    set low = low >> 9
    set (high, low) = scr(high, low, spread)
    set (high, low) = scl(high, low, shift)
    set high = high + objects.y[slot]
    set (high, low) = rcl(high, low, 18)
    set high = high + objects.x[slot]
    emit display: high, low, 3
    set particles = particles + 1
    if particles >= 0:
      break
  set objects.counter[slot] = objects.counter[slot] + 1
  if objects.counter[slot] < 0:
    return
  set objects.routine[slot] = none

# A torpedo flies straight, bent only by the torpedo space warpage, until
# its life runs out and it explodes.
processor torpedo(slot)                                     # tcr
  writes: objects, display
  set objects.counter[slot] = objects.counter[slot] + 1
  if objects.counter[slot] >= 0:
    set objects.routine[slot] = explosion
    set objects.counter[slot] = -2
    return
  let coordinate = objects.x[slot] >> 9
  set (objects.dy[slot], objects.y[slot]) = inertia(torpedo_space_warpage(coordinate), objects.dy[slot], objects.y[slot])
  set coordinate = objects.y[slot] >> 9
  set (objects.dx[slot], objects.x[slot]) = inertia(torpedo_space_warpage(coordinate), objects.dx[slot], objects.x[slot])
  emit display: objects.x[slot], objects.y[slot], 1

# A ship in hyperspace is not drawn and does not collide. When its time is
# up it jumps by a random displacement, takes a random velocity and
# heading, and breakout begins.
processor in_hyperspace(slot)                               # hp1
  requires: slot < 2
  writes: objects, ships, random
  set objects.counter[slot] = objects.counter[slot] + 1
  if objects.counter[slot] < 0:
    return
  set objects.routine[slot] = breakout
  set objects.cycles[slot] = 7
  set random.number = next_random(random.number)
  # The original shifts the random number into IO, which holds whatever
  # the main loop left there; the shifts push all of that out again.
  let (high, low) = scr(random.number, 0, 9)
  set low = low >> 9
  set (high, low) = hyperspatial_displacement(high, low)
  set high = high + objects.x[slot]
  set objects.x[slot] = high
  set (high, low) = rcl(high, low, 18)
  set high = high + objects.y[slot]
  set objects.y[slot] = high
  set random.number = next_random(random.number)
  set (high, low) = scr(random.number, low, 9)
  set low = low >> 9
  set (high, low) = hyperspatial_velocity(high, low)
  set objects.dy[slot] = high
  set objects.dx[slot] = low
  set ships.angle[slot] = random.number
  let angle_steps = -3
  loop at most 3:                   # bring the new heading within a turn
    let heading = ships.angle[slot]
    if heading >= 0:
      set heading = heading - 0311040
    if heading < 0:
      set heading = heading + 0311040
    set ships.angle[slot] = heading
    set angle_steps = angle_steps + 1
    if angle_steps >= 0:
      break
  set objects.counter[slot] = breakout_time()

# Breakout: the ship shows as a dot and can collide again. When its time is
# up it gets its own calc routine back, uses up a jump, starts the
# hyperfield generators' recharge and takes on more uncertainty; then it
# survives only if a random number outweighs the uncertainty.
processor breakout(slot)                                    # hp3
  requires: slot < 2
  reads: tunables
  writes: objects, ships, random, display
  set objects.counter[slot] = objects.counter[slot] + 1
  if objects.counter[slot] >= 0:
    set objects.routine[slot] = ships.saved_routine[slot]
    set objects.cycles[slot] = 02000
    set ships.jumps_left[slot] = ships.jumps_left[slot] + 1
    if ships.jumps_left[slot] >= 0:
      set ships.jumps_left[slot] = 0
    set ships.recharge[slot] = hyperfield_recharge_time()
    set ships.uncertainty[slot] = ships.uncertainty[slot] + tunables.hyperspatial_uncertainty
    set random.number = next_random(random.number)
    if (random.number | 0400000) + ships.uncertainty[slot] < 0:
      return
    set objects.routine[slot] = explosion
    set objects.counter[slot] = -010
    set objects.cycles[slot] = 02000
  emit display: objects.x[slot], objects.y[slot], 2
